# Build trees
build/
out/
# Unity generated
unity/[Ll]ibrary/
unity/[Tt]emp/
unity/[Oo]bj/
unity/[Bb]uild/
unity/[Bb]uilds/
unity/[Ll]ogs/
unity/[Uu]ser[Ss]ettings/
unity/*.csproj
unity/*.sln
unity/.vs/
# The editor copies the engine libraries in from engine/, never committed
unity/Assets/Plugins/x86_64/
unity/Assets/Plugins/WebGL/
unity/*.slnx
# Written by the editor for in-app purchasing, not used here
unity/Assets/Resources/
unity/Assets/Resources.meta

# Sprite-feature replacements painted from the player's own files, never committed
unity/Assets/Overrides/Generated/
unity/Assets/Overrides/Generated.meta
__pycache__/

# Studio Mode: its scene is made on first use, and dropped models and
# screenshots stay on the artist's machine
unity/Assets/Scenes/Studio.unity
unity/Assets/Scenes/Studio.unity.meta
unity/Assets/Overrides/Drop/
unity/Assets/Overrides/Drop.meta
Captures/

# Grids read off the original pictures, remade by the kits that use them
tools/sprite-replace/hand/**/*.npy

# Written by the alpha build for the player, and removed after it
unity/Assets/Game/Resources/BuildStamp.txt
unity/Assets/Game/Resources/BuildStamp.txt.meta
